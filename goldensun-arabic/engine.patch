diff --git a/src/ui/rtl.c b/src/ui/rtl.c
new file mode 100644
index 0000000..56ba252
--- /dev/null
+++ b/src/ui/rtl.c
@@ -0,0 +1,255 @@
+/* ---- Arabic: right-to-left text ------------------------------------------
+ * Text is stored in logical order. DrawText mirrors each glyph's x inside its
+ * window, so the first letter lands on the right, every line is right-aligned
+ * and the typewriter starts from the right. A run of Latin letters or digits
+ * (an English name, a number the game fills in) must still read left to
+ * right: BufferString flips each such run once the text is expanded, and the
+ * mirroring flips it back. */
+
+/* 0x7F in the menu font is the solid tile the game clears windows with, so it
+   keeps it; the isolated yeh-hamza the text puts there is drawn as the final
+   form (0x95), which looks the same. */
+#define RTL_SMALL_BLANK 0x7f
+#define RTL_YEH_HAMZA_FINAL 0x95
+
+extern unsigned char *gRtlTextBase __asm__("iwram_3001e8c");
+extern const unsigned short Data_32224[];
+extern const unsigned char Data_370d4[];
+extern int BufferString_orig(unsigned int id, int flag);
+extern int DrawText_orig(void *win, unsigned int ch, int x, int y, int flag);
+extern int DrawMsgGlyph_orig(unsigned int ch, unsigned char *out);
+extern int Func_801de5c_orig(unsigned short *s, void *a1, void *a2, int a3);
+extern void *alloc_ewram(int size);
+extern void free(void *p);
+
+/* Extra halfwords each control code carries, as Func_8017aa4 skips them.
+   (A function, not a table: this unit's .rodata is not linked.) */
+static int RtlCodeArgs(unsigned int c)
+{
+    if ((c >= 0x08 && c <= 0x0c) || c == 0x11 || c == 0x1d)
+        return 1;
+    if (c == 0x0e || c == 0x0f || c == 0x1c)
+        return 2;
+    return 0;
+}
+
+static int RtlIsLtr(unsigned int c)
+{
+    return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
+}
+
+/* Arabic letters: 0x8C-0xFF, and the ASCII codes lent to the rarest forms. */
+static int RtlIsArabic(unsigned int c)
+{
+    if (c >= 0x8c && c <= 0xff)
+        return 1;
+    return c == '<' || c == '>' || c == '@' || (c >= '[' && c <= '^') || c == '`' || (c >= '{' && c <= 0x7f);
+}
+
+int BufferString(unsigned int id, int flag)
+{
+    unsigned short *buf = (unsigned short *)(gRtlTextBase + 0xeb0);
+    int start = BufferString_orig(id, flag);
+    int i = start;
+    int n;
+
+    /* id -1 hands back the string already in the buffer, flipped already */
+    if (id == 0xffffffff)
+        return start;
+
+    /* up to the string's NUL: when only measuring (flag 0) the write index
+       does not move, so it cannot mark the end */
+    for (n = 0; n < 0x200 && buf[i] != 0; n++) {
+        unsigned int c = buf[i];
+        int j, last;
+
+        if (c < 0x20) {
+            i = (i + 1 + RtlCodeArgs(c)) & 0x1ff;
+            continue;
+        }
+        if (!RtlIsLtr(c)) {
+            i = (i + 1) & 0x1ff;
+            continue;
+        }
+        /* the run: from here to the last Latin letter or digit before the next
+           Arabic letter or control code, neutral marks between them included */
+        last = i;
+        for (j = i; buf[j] != 0; j = (j + 1) & 0x1ff) {
+            c = buf[j];
+            if (c < 0x20 || c > 0xff || RtlIsArabic(c))
+                break;
+            if (RtlIsLtr(c))
+                last = j;
+        }
+        j = last;
+        while (i != j) {
+            unsigned short t = buf[i];
+            buf[i] = buf[j];
+            buf[j] = t;
+            i = (i + 1) & 0x1ff;
+            if (i == j)
+                break;
+            j = (j - 1) & 0x1ff;
+        }
+        i = (last + 1) & 0x1ff;
+    }
+    return start;
+}
+
+int DrawText(void *win, unsigned int ch, int x, int y, int flag)
+{
+    if (ch > 0x20 && ch <= 0xff) {
+        /* windows with flag 8 draw with the small 8x8 font (file 0x13), whose
+           advance widths are Data_370d4, as DrawText_orig picks it */
+        int small = flag != 1 && (*(unsigned short *)((unsigned char *)win + 0x16) & 8);
+        int bound = *(unsigned short *)((unsigned char *)win + 8) * 8 - 12;
+        int w;
+
+        if (small && ch == RTL_SMALL_BLANK)
+            ch = RTL_YEH_HAMZA_FINAL;
+        w = small ? Data_370d4[ch - 0x20] : Data_32224[(ch - 0x20) * 16];
+
+        x = bound - x - w;
+        if (x < 0)
+            x = 0;
+    }
+    return DrawText_orig(win, ch, x, y, flag);
+}
+
+/* Button and status icons: 0x80-0x8B, and the 0xF0xx codes */
+static int RtlIsIcon(unsigned int c)
+{
+    return c > 0xff || (c >= 0x80 && c <= 0x8b);
+}
+
+static void RtlReverse(unsigned short *s, int i, int j)
+{
+    while (i < j) {
+        unsigned short t = s[i];
+        s[i] = s[j];
+        s[j] = t;
+        i++;
+        j--;
+    }
+}
+
+/* Menus draw a whole string at once with Func_801de5c (small font, packed
+   into tiles), not glyph by glyph through DrawText, so there is no x to
+   mirror: each run of printable text is put in visual order instead, the
+   first letter last. A string BufferString expanded (it sits in its buffer)
+   already has its Latin runs flipped, and the reversal turns them back; any
+   other string (a number, a name) gets them flipped here first. */
+int Func_801de5c(unsigned short *src, void *a1, void *a2, int a3)
+{
+    unsigned char *ring = gRtlTextBase + 0xeb0;
+    int expanded = (unsigned char *)src >= ring && (unsigned char *)src < ring + 0x400;
+    unsigned short *s;
+    int n, i, j, k, ret;
+
+    for (n = 0; n < 0x1ff && src[n] != 0; n++)
+        ;
+    s = alloc_ewram((n + 1) * 2);
+    for (i = 0; i <= n; i++)
+        s[i] = src[i] == RTL_SMALL_BLANK ? RTL_YEH_HAMZA_FINAL : src[i];
+
+    i = 0;
+    while (i < n) {
+        if (s[i] < 0x20) {
+            i += 1 + RtlCodeArgs(s[i]);
+            continue;
+        }
+        for (j = i; j < n && s[j] >= 0x20; j++)
+            ;
+        if (!expanded) {
+            /* Latin runs, neutral marks between their letters included */
+            for (k = i; k < j; k++) {
+                int last;
+                if (!RtlIsLtr(s[k]))
+                    continue;
+                last = k;
+                while (last + 1 < j && s[last + 1] <= 0xff && !RtlIsArabic(s[last + 1])) {
+                    int m = last + 1;
+                    while (m < j && s[m] <= 0xff && !RtlIsArabic(s[m]) && !RtlIsLtr(s[m]))
+                        m++;
+                    if (m < j && RtlIsLtr(s[m]))
+                        last = m;
+                    else
+                        break;
+                }
+                RtlReverse(s, k, last);
+                k = last;
+            }
+        }
+        RtlReverse(s, i, j - 1);
+        /* icons drawn over two cells (the L/R buttons, HP/PP) keep their order */
+        for (k = i; k < j; k++) {
+            int m;
+            if (!RtlIsIcon(s[k]))
+                continue;
+            for (m = k; m + 1 < j && RtlIsIcon(s[m + 1]); m++)
+                ;
+            RtlReverse(s, k, m);
+            k = m;
+        }
+        i = j;
+    }
+    ret = Func_801de5c_orig(s, a1, a2, a3);
+    free(s);
+    return ret;
+}
+
+/* Func_801e7c0 draws one game string in a window, from x pixels in. The
+   same steps, but a single-line window (a title, the menu bar's label) whose
+   text starts at its left edge gets the text against its right edge. */
+int Func_801e7c0(unsigned int id, void *win, int x, int y)
+{
+    unsigned char *base = gRtlTextBase;
+    unsigned short *index = (unsigned short *)(base + 0x12b2);
+    unsigned short *buf = (unsigned short *)(base + 0xeb0);
+    unsigned short *w16 = (unsigned short *)win;
+    int tile, i;
+
+    *index = 0;
+    BufferString(id, 1);
+    buf[*index] = 0;
+    *index = (*index + 1) & 0x1ff;
+
+    if (x == 0 && w16[5] == 3) {
+        int width = 0, room = (w16[4] - 2) * 8;
+
+        for (i = 0; i < 0x1ff && buf[i] != 0; i++) {
+            unsigned int c = buf[i];
+            if (c < 0x20)
+                i += RtlCodeArgs(c);
+            else if (c <= 0xff)
+                width += Data_370d4[c - 0x20];
+            else
+                width += 8;
+        }
+        if (width < room)
+            x = room - width;
+    }
+
+    tile = ((w16[7] + (y >> 3) + 1) << 5) + w16[6] + (x >> 3) + 1;
+    if (tile >= 0x280)
+        return 0;
+    return Func_801de5c(buf, base + tile * 2, (unsigned char *)0x6002000 + tile * 2, x & 7);
+}
+
+/* A dialogue letter is a 16x16 sprite: the glyph from column 0, its shadow one
+   pixel down and right. Drawn right to left, a letter's shadow past its own
+   width landed on the first column of the letter before it (on its right) and
+   cut the join (الملف, نحو); what lies past the width is cleared. */
+int DrawMsgGlyph(unsigned int ch, unsigned char *out)
+{
+    int w = DrawMsgGlyph_orig(ch, out);
+    int x, y;
+
+    for (y = 0; y < 16; y++) {
+        for (x = w; x < 16; x++) {
+            unsigned char *p = out + ((y >> 3) * 2 + (x >> 3)) * 32 + (y & 7) * 4 + (x & 7) / 2;
+            *p &= (x & 1) ? 0x0f : 0xf0;
+        }
+    }
+    return w;
+}
