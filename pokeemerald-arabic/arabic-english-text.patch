+/**
+ * The Arabic letter to draw for this byte, given the letters around it.
+ *
+ * Text that came from the translation file is already shaped, but text the
+ * game puts together while it runs is not: a name the player typed, or a name
+ * substituted into a sentence, only meets its neighbours here. So every byte
+ * is read back to its base letter and shaped again from what actually sits
+ * beside it -- an already-shaped line comes out unchanged, and a seam that was
+ * never shaped is joined.
+ *
+ * lam followed by an alef is one glyph in Arabic, never two, so that pair is
+ * consumed together.
+ */
+static u16 ShapeArabicChar(struct TextPrinter *textPrinter, u16 currChar)
+{
+    struct TextPrinterSubStruct *subStruct = (struct TextPrinterSubStruct *)(&textPrinter->subStructFields);
+    const u8 *next;
+    u8 base, nextBase, form;
+    u32 i;
+
+    if (currChar >= 0x100)
+    {
+        subStruct->arabicPrev = 0;
+        return currChar;
+    }
+    base = sArabicBaseOf[currChar];
+    if (base == ARABIC_NO_BASE)
+    {
+        subStruct->arabicPrev = 0;
+        return currChar;
+    }
+
+    // What follows, stepping over the codes that carry arguments. A line break
+    // or the end of the string is not a neighbour: nothing joins across it.
+    next = textPrinter->printerTemplate.currentChar;
+    while (*next == EXT_CTRL_CODE_BEGIN)
+    {
+        // A code that moves the pen ends the run: the keys of a keyboard row
+        // are laid out with these and must not join into one another.
+        if (next[1] == EXT_CTRL_CODE_CLEAR || next[1] == EXT_CTRL_CODE_CLEAR_TO
+         || next[1] == EXT_CTRL_CODE_SKIP_TO)
+            break;
+        next += 2 + GetExtCtrlCodeLength(next[1]);
+    }
+    nextBase = (*next < 0x100 && *next != EXT_CTRL_CODE_BEGIN) ? sArabicBaseOf[*next] : ARABIC_NO_BASE;
+
+    // A lam-alef glyph is already both letters: it only chooses between its
+    // own two forms, and nothing joins out of it.
+    if (base == ARABIC_BASE_LIGATURE)
+    {
+        currChar = sArabicLamAlef[sArabicLigatureOf[currChar]][subStruct->arabicPrev ? 2 : 1];
+        subStruct->arabicPrev = 0;
+        return currChar;
+    }
+
+    if (base == ARABIC_BASE_LAM && nextBase != ARABIC_NO_BASE)
+    {
+        for (i = 0; i < ARRAY_COUNT(sArabicLamAlef); i++)
+        {
+            if (sArabicLamAlef[i][0] == nextBase)
+            {
+                textPrinter->printerTemplate.currentChar = next + 1;
+                currChar = sArabicLamAlef[i][subStruct->arabicPrev ? 2 : 1];
+                subStruct->arabicPrev = 0; // an alef never joins forward
+                return currChar;
+            }
+        }
+    }
+
+    form = 0;
+    if (subStruct->arabicPrev)
+        form |= ARABIC_FORM_FINAL;
+    // A letter joins forward only if it has an initial form at all.
+    if (nextBase != ARABIC_NO_BASE && sArabicForms[base][ARABIC_FORM_INITIAL])
+        form |= ARABIC_FORM_INITIAL;
+
+    if (sArabicForms[base][form])
+        currChar = sArabicForms[base][form];
+    else if (sArabicForms[base][form & ARABIC_FORM_FINAL])
+        currChar = sArabicForms[base][form & ARABIC_FORM_FINAL];
+
+    // base + 1, so zero keeps meaning "nothing joins into this one"
+    subStruct->arabicPrev = (form & ARABIC_FORM_INITIAL) ? base + 1 : 0;
+    return currChar;
+}
