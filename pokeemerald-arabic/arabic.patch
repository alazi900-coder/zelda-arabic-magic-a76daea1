+// Every window is drawn mirrored right-to-left (see CopyGlyphToWindow), so a
+// number's digits — always written most-significant-first here — would read
+// backwards on screen unless reversed first, canceling the outer mirror back
+// to normal left-to-right digit order.
+static void ReverseDigitRun(u8 *start, u8 *end)
+{
+    while (start < end)
+    {
+        u8 tmp = *start;
+        *start = *end;
+        *end = tmp;
+        start++;
+        end--;
+    }
+}
+
 u8 *ConvertIntToDecimalStringN(u8 *dest, s32 value, enum StringConvertMode mode, u8 n)
