diff --git a/include/render_text.h b/include/render_text.h
index baf38494..f8a8fc46 100644
--- a/include/render_text.h
+++ b/include/render_text.h
@@ -52,6 +52,20 @@ typedef struct TextPrinterSubstruct {
     u8 scrollArrowYPosIdx : 2;
     u8 fontIDSet : 1;
     u8 autoScrollDelay : 8;
+    // The base letter of the character just drawn, plus one, so that zero
+    // keeps meaning "nothing joins into the next one". Three of the seven
+    // bytes this struct is given were unused.
+    u8 arabicPrev;
+    // A run of digits or Latin letters inside right-to-left text still reads
+    // left to right, so it has to survive the mirroring the window applies to
+    // every glyph. These describe the run currently being drawn: how many of
+    // its glyphs are left, where it began, and how wide the whole run is --
+    // enough to place each glyph at its mirror image *within the run*, which
+    // the window's own mirroring then turns the right way round again. Zero
+    // ltrLeft means no run is in progress.
+    u8 ltrLeft;
+    u8 ltrStartX;
+    u8 ltrWidth;
 } TextPrinterSubstruct;
 
