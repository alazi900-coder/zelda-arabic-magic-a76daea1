+/**
+ * Where a box of `width` pixels starting at `x` lands once the window's own
+ * right-to-left mirroring is applied -- the same transform `Window_CopyGlyph`
+ * uses for a glyph, exposed so anything that has to *erase* what a mirrored
+ * glyph drew can target the place it actually landed.
+ *
+ * `ColoredArrow_Print` (the list-cursor arrow) is ordinary text and gets
+ * mirrored like any other glyph, but the code that erases it before redrawing
+ * it one row down calls `Window_FillRectWithColor` directly -- a plain
+ * rectangle fill that knows nothing about glyph mirroring. Erasing at the
+ * unmirrored coordinate left the *actual*, mirrored arrow on screen and wiped
+ * empty space instead, so a cursor moved through a list left every position
+ * it had visited still lit up behind it.
+ */
+u16 Window_MirrorX(const Window *window, u16 x, u16 width)
+{
+    u16 destWidth = window->width * 8;
+    int mirroredX = (int)destWidth - (int)x - (int)width;
+
+    if (mirroredX < 0) {
+        mirroredX = 0;
+    }
+
+    return (u16)mirroredX;
+}
+
 void Window_CopyGlyph(Window *window, const u8 *glyphPixels, u16 srcWidth, u16 srcHeight, u16 destX, u16 destY, u16 table)
 {
     u8 *windowPixels = window->pixels;
