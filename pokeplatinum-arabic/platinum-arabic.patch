diff --git a/src/render_text.c b/src/render_text.c
index 8a98037d..7bfdab8a 100644
--- a/src/render_text.c
+++ b/src/render_text.c
@@ -1,5 +1,7 @@
 #include "render_text.h"
 
+#include "arabic_shaping.h"
+
 #include <nitro.h>
 #include <string.h>
 
@@ -39,6 +41,159 @@ enum RenderState {
     RENDER_STATE_PAUSE,
 };
 
+/**
+ * Give an Arabic letter the shape its neighbours call for, as it is drawn.
+ *
+ * Arabic letters change form depending on what they join to, and a game builds
+ * half its sentences while it runs -- a name the player typed, a species
+ * dropped into a line of dialogue. Those seams only exist at print time, so
+ * that is where the joining has to be decided; text shaped when it was stored
+ * would come apart at exactly the places players look at most.
+ *
+ * Each character is read back to its base letter first, so a line that already
+ * carries the right forms passes through unchanged and one that does not gets
+ * fixed.
+ */
+static charcode_t ShapeArabicChar(TextPrinter *printer, TextPrinterSubstruct *substruct, charcode_t currChar)
+{
+    const charcode_t *next;
+    u8 base, nextBase, form;
+    u32 i;
+
+    if (currChar >= ARABIC_CODE_MAX) {
+        substruct->arabicPrev = 0;
+        return currChar;
+    }
+
+    base = sArabicBaseOf[currChar];
+
+    if (base == ARABIC_NO_BASE) {
+        substruct->arabicPrev = 0;
+        return currChar;
+    }
+
+    // What comes next. Every control code in this game is 0x0200 or above, so
+    // the same test that finds a letter also refuses to join across one.
+    next = printer->template.toPrint.raw;
+    nextBase = (*next < ARABIC_CODE_MAX) ? sArabicBaseOf[*next] : ARABIC_NO_BASE;
+
+    // A lam-alef glyph is already both letters: it only chooses between its own
+    // two forms, and nothing joins out of it.
+    if (base == ARABIC_BASE_LIGATURE) {
+        currChar = sArabicLamAlef[sArabicLigatureOf[currChar]][substruct->arabicPrev ? 2 : 1];
+        substruct->arabicPrev = 0;
+        return currChar;
+    }
+
+    if (base == ARABIC_BASE_LAM && nextBase != ARABIC_NO_BASE) {
+        for (i = 0; i < NELEMS(sArabicLamAlef); i++) {
+            if (sArabicLamAlef[i][0] == nextBase) {
+                printer->template.toPrint.raw = next + 1;   // the alef is drawn with the lam
+                currChar = sArabicLamAlef[i][substruct->arabicPrev ? 2 : 1];
+                substruct->arabicPrev = 0;                  // an alef never joins forward
+                return currChar;
+            }
+        }
+    }
+
+    form = 0;
+
+    if (substruct->arabicPrev) {
+        form |= ARABIC_FORM_FINAL;
+    }
+
+    // A letter joins forward only if it has an initial form at all.
+    if (nextBase != ARABIC_NO_BASE && sArabicForms[base][ARABIC_FORM_INITIAL]) {
+        form |= ARABIC_FORM_INITIAL;
+    }
+
+    if (sArabicForms[base][form]) {
+        currChar = sArabicForms[base][form];
+    } else if (sArabicForms[base][form & ARABIC_FORM_FINAL]) {
+        currChar = sArabicForms[base][form & ARABIC_FORM_FINAL];
+    }
+
+    substruct->arabicPrev = (form & ARABIC_FORM_INITIAL) ? base + 1 : 0;
+    return currChar;
+}
+
+// Digits and Latin letters occupy one unbroken stretch of the character set,
+// so a left-to-right character is a single range test.
+#define IS_LTR_CHAR(c) ((c) >= CHAR_0 && (c) <= CHAR_z)
+
+/**
+ * Whether a character has no direction of its own -- punctuation, symbols, the
+ * space -- as opposed to a letter or digit, which does.
+ *
+ * The apostrophe in "It's", the comma in "1,000" and the space in "TM 42"
+ * belong to the text beside them; the same space between two Arabic words
+ * belongs to the Arabic. Which it is depends on the neighbours, so ScanLtrRun
+ * holds these back until a further left-to-right character proves they are
+ * inside the run. Enumerating them was a mistake -- the list was always going
+ * to miss one, and it missed the apostrophe -- so the test is what they are
+ * not: not a control code, not Latin, not Arabic.
+ */
+static BOOL IsLtrNeutralChar(charcode_t c)
+{
+    if (c >= CHAR_CONTROL_SCREEN_INDICATOR || IS_LTR_CHAR(c)) {
+        return FALSE;
+    }
+
+    return c >= ARABIC_CODE_MAX || sArabicBaseOf[c] == ARABIC_NO_BASE;
+}
+
+/**
+ * Measure the left-to-right run starting at `str` and remember it on the printer.
+ *
+ * The window mirrors every glyph it is handed, which is what puts Arabic on the
+ * right way round -- but it does the same to a level number or a Pokémon's name
+ * in Latin, and those still read left to right. "25" came out "52".
+ *
+ * Rather than fight the mirroring, this feeds it what it needs: each glyph of
+ * the run is placed at its mirror image within the run's own span, so that the
+ * window's mirroring cancels out and the run reads forwards again, while the
+ * run as a whole still sits where right-to-left order puts it.
+ *
+ * Measuring costs one pass over the run, once, when its first character is
+ * reached. Font_TryLoadGlyph overwrites the font's shared glyph buffer, so this
+ * has to run before the caller loads the glyph it is about to draw.
+ */
+static void ScanLtrRun(TextPrinter *printer, TextPrinterSubstruct *substruct, const charcode_t *str)
+{
+    u32 count = 0, width = 0, heldCount = 0, heldWidth = 0;
+
+    while (TRUE) {
+        charcode_t c = *str;
+        u32 advance;
+
+        if (IS_LTR_CHAR(c)) {
+            advance = Font_TryLoadGlyph(substruct->fontID, c)->width + printer->template.letterSpacing;
+            count += heldCount + 1;
+            width += heldWidth + advance;
+            heldCount = 0;
+            heldWidth = 0;
+        } else if (count != 0 && IsLtrNeutralChar(c)) {
+            advance = Font_TryLoadGlyph(substruct->fontID, c)->width + printer->template.letterSpacing;
+            heldCount++;
+            heldWidth += advance;
+        } else {
+            break;
+        }
+
+        str++;
+    }
+
+    // A run wider than a screen cannot happen, but the fields are bytes, so a
+    // run that would not fit in them is left to render as it did before.
+    if (count == 0 || count > 0xFF || width > 0xFF) {
+        return;
+    }
+
+    substruct->ltrLeft = count;
+    substruct->ltrStartX = printer->template.currX;
+    substruct->ltrWidth = width;
+}
+
 enum RenderResult RenderText(TextPrinter *printer)
 {
     TextPrinterSubstruct *substruct = (TextPrinterSubstruct *)printer->substruct;
@@ -77,6 +232,8 @@ enum RenderResult RenderText(TextPrinter *printer)
             return RENDER_FINISH;
 
         case CHAR_CR:
+            substruct->arabicPrev = 0;
+            substruct->ltrLeft = 0;
             printer->template.currX = printer->template.x;
             printer->template.currY += Font_GetAttribute(printer->template.fontID, 1) + printer->template.lineSpacing;
             return RENDER_REPEAT;
@@ -194,12 +351,29 @@ enum RenderResult RenderText(TextPrinter *printer)
             return RENDER_UPDATE;
         }
 
+        currChar = ShapeArabicChar(printer, substruct, currChar);
+
+        if (substruct->ltrLeft == 0 && IS_LTR_CHAR(currChar)) {
+            ScanLtrRun(printer, substruct, printer->template.toPrint.raw - 1);
+        }
+
         const TextGlyph *glyph = Font_TryLoadGlyph(substruct->fontID, currChar);
+        u16 destX = printer->template.currX;
+
+        if (substruct->ltrLeft != 0) {
+            // The mirror image of this glyph's slot within the run, so that the
+            // window's own mirroring puts it back in reading order.
+            destX = substruct->ltrStartX + substruct->ltrWidth
+                - (printer->template.currX - substruct->ltrStartX)
+                - (glyph->width + printer->template.letterSpacing);
+            substruct->ltrLeft--;
+        }
+
         Window_CopyGlyph(printer->template.window,
             glyph->gfx,
             glyph->width,
             glyph->height,
-            printer->template.currX,
+            destX,
             printer->template.currY,
             printer->template.glyphTable);
 
