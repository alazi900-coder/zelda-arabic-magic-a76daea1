+#include "NDSCart.h"
+#include "Args.h"
+#include "GlyphTrace.h"
+#include "GPU.h"
+
+using namespace melonDS;
+
+// Set once main() has the live NDS instance, so WalkFontMgr (called from deep
+// inside the CPU-hook chain) can issue live reads at the exact CPU cycle
+// GT_Regs fires it — not from a RAM dump taken at some other, later frame.
+static NDS* g_nds = nullptr;
+
+// Plain pointer reads into MainRAM — NOT nds->ARM9.DataRead*. This function
+// runs nested inside ARMv5::CodeRead32, itself called from the middle of an
+// instruction fetch; going back through the CPU's own DataRead path from
+// there is reentrant (it touches CodeCycles/timing state the current fetch
+// is still using) and silently wrecked the trace: the very first walk ever
+// fired, after which that PC was never reached again for the rest of the
+// run (confirmed by comparing against a GT_LOGAT trace at the identical PC,
+// which alone — no nested DataRead calls — kept firing normally, ~200 times).
+// A raw buffer read has no such side effect.
+static inline u32 RamAddr(u32 addr) { return addr & g_nds->MainRAMMask; }
+static inline u32 ReadRAM32(u32 addr) { return *(u32*)&g_nds->MainRAM[RamAddr(addr)]; }
+static inline u16 ReadRAM16(u32 addr) { return *(u16*)&g_nds->MainRAM[RamAddr(addr)]; }
+
+static void PeekSP(u32 sp)
+{
+    if (!g_nds || !GT_Out) return;
+    u32 addr = sp + 0x28;
+    u32 val;
+    if ((addr & g_nds->ARM9.DTCMMask) == g_nds->ARM9.DTCMBase)
+        val = *(u32*)&g_nds->ARM9.DTCM[addr & 0x3FFF];
+    else
+        val = ReadRAM32(addr);
+    std::fprintf(GT_Out, "PEEK sp=%08X [sp+0x28]=%08X\n", sp, val);
+    std::fflush(GT_Out);
+}
+
+static void WalkFontMgr(u32 fontMgr)
+{
+    if (!g_nds || !GT_Out) return;
+    std::fprintf(GT_Out, "WALK fontMgr=%08X\n", fontMgr);
+    // Original disasm notation was r0=[[param1+0]+0x10] — TWO dereferences:
+    // param1 (fontMgr/R0) itself isn't the node-list owner, it points to one.
+    u32 objPtr = ReadRAM32(fontMgr + 0x0);
+    u32 head = ReadRAM32(objPtr + 0x10);
+    std::fprintf(GT_Out, "WALK objPtr=%08X head=%08X\n", objPtr, head);
+    u32 node = head;
+    for (int guard = 0; node != 0 && guard < 64; guard++)
+    {
+        u16 first = ReadRAM16(node + 0x0);
+        u16 last  = ReadRAM16(node + 0x2);
+        u16 method = ReadRAM16(node + 0x4);
+        u32 next  = ReadRAM32(node + 0x8);
+        std::fprintf(GT_Out, "WALK node=%08X first=%04X last=%04X method=%04X next=%08X\n",
+                     node, first, last, method, next);
+        if (method == 2)
+        {
+            u16 count = ReadRAM16(node + 0xC);
+            std::fprintf(GT_Out, "WALK   count=%04X entries:", count);
+            for (u32 e = 0; e < count && e < 400; e++)
+            {
+                u16 k = ReadRAM16(node + 0xE + e * 4);
+                u16 v = ReadRAM16(node + 0xE + e * 4 + 2);
+                std::fprintf(GT_Out, " (%04X,%04X)", k, v);
+            }
+            std::fprintf(GT_Out, "\n");
+        }
+        if (next == node) break;
+        node = next;
+    }
+    std::fflush(GT_Out);
+}
+
+static void SaveShot(NDS& nds, const std::string& path)
+{
+    void* top = nullptr; void* bot = nullptr;
+    if (!nds.GPU.GetFramebuffers(&top, &bot) || !top || !bot) return;
+    FILE* p = std::fopen(path.c_str(), "wb");
+    if (!p) return;
+    std::fprintf(p, "P6\n256 384\n255\n");
+    for (int half = 0; half < 2; half++)
+    {
+        const u32* fb = (const u32*) (half ? bot : top);
+        for (int i = 0; i < 256*192; i++)
+        {
+            u32 c = fb[i];
+            u8 rgb[3] = { (u8)((c >> 16) & 0xFF), (u8)((c >> 8) & 0xFF), (u8)(c & 0xFF) };
+            std::fwrite(rgb, 1, 3, p);
+        }
+    }
+    std::fclose(p);
+}
+
+int main(int argc, char** argv)
+{
+    if (argc < 5) {
+        std::fprintf(stderr, "usage: gtrace <rom.nds> <lo hex> <hi hex> <frames> [out]\n");
+        return 2;
+    }
+    const char* rompath = argv[1];
+    u32 lo = (u32) strtoul(argv[2], nullptr, 16);
+    u32 hi = (u32) strtoul(argv[3], nullptr, 16);
+    int frames = atoi(argv[4]);
+    const char* outpath = (argc > 5) ? argv[5] : "/tmp/gtrace.txt";
+
+    FILE* f = std::fopen(rompath, "rb");
+    if (!f) { std::perror("rom"); return 1; }
+    std::fseek(f, 0, SEEK_END); long len = std::ftell(f); std::fseek(f, 0, SEEK_SET);
+    auto rom = std::make_unique<u8[]>(len);
+    if (std::fread(rom.get(), 1, len, f) != (size_t) len) { std::fprintf(stderr, "short read\n"); return 1; }
+    std::fclose(f);
+
+    NDSArgs args {};
+    // the JIT compiles its own memory accesses and never enters
+    // ARMv5::DataRead*, where the trace hook lives — the interpreter does
+    args.JIT = std::nullopt;
+    // on the heap: NDS carries the console's whole memory as members, so a
+    // stack instance overflows before main's first statement finishes
+    auto nds = std::make_unique<NDS>(std::move(args));
+    g_nds = nds.get();
+    nds->SetNDSCart(NDSCart::ParseROM(std::move(rom), (u32) len));
+    nds->Reset();
+    nds->SetupDirectBoot("gtrace");   // skip the firmware boot menu
+    nds->Start();
+
+    GT_Out = std::fopen(outpath, "w");
+    GT_Lo = lo; GT_Hi = hi;
+    if (const char* wr = getenv("GT_WRITE")) { unsigned a=0,b=0; sscanf(wr, "%x:%x", &a, &b); GT_WLo=a; GT_WHi=b; }
+    if (const char* rr = getenv("GT_REGS")) { unsigned a=0; int n=1; sscanf(rr, "%x:%d", &a, &n); GT_RegsAt=a; GT_RegsLeft=n; }
+    if (const char* xr = getenv("GT_EXEC")) { unsigned a=0,b=0; sscanf(xr, "%x:%x", &a, &b); GT_XLo=a; GT_XHi=b; }
+    if (const char* la = getenv("GT_LOGAT")) { GT_LogAt = (unsigned) strtoul(la, nullptr, 16); const char* ln = getenv("GT_LOGN"); GT_LogLeft = ln ? atoi(ln) : 20; }
+    if (const char* wa = getenv("GT_WALKAT")) { unsigned a=0; int n=1; sscanf(wa, "%x:%d", &a, &n); GT_WalkAt=a; GT_WalkLeft=n; GT_WalkFn=WalkFontMgr; }
+    if (const char* pa2 = getenv("GT_PEEKAT")) { unsigned a=0; int n=1; sscanf(pa2, "%x:%d", &a, &n); GT_PeekAt=a; GT_PeekLeft=n; GT_PeekFn=PeekSP; }
+    // Drive itself: the interesting code only runs once the game is past the
+    // title and into dialogue, and nothing here can press a button otherwise.
+    // A touch every half second plus A advances titles, menus and text boxes.
+    const char* dumpAt = getenv("GT_DUMP_FRAME");
+    const char* dumpPath = getenv("GT_DUMP_PATH");
+    for (int i = 0; i < frames; i++)
+    {
+        if (dumpAt && atoi(dumpAt) == i && dumpPath) {
+            FILE* mf = fopen(dumpPath, "wb");
+            for (u32 a = 0x02000000; a < 0x02400000; a += 4) {
+                u32 v; nds->ARM9.DataRead32(a, &v);
+                fwrite(&v, 4, 1, mf);
+            }
+            fclose(mf);
+            fprintf(stderr, "dumped mainram at frame %d to %s\n", i, dumpPath);
+        }
+        int ph = i % 30;
+        if (ph == 0)      { nds->TouchScreen(128, 96); nds->SetKeyMask(~0x0001); }  // A held
+        else if (ph == 6) { nds->ReleaseScreen();      nds->SetKeyMask(~0u); }
+        {
+            const char* pa = getenv("GT_POKE_ADDR");
+            if (pa) {
+                unsigned addr = (unsigned) strtoul(pa, nullptr, 16);
+                const char* pf = getenv("GT_POKE_FROM"); int from = pf ? atoi(pf) : 0;
+                const char* pt = getenv("GT_POKE_TO");   int to   = pt ? atoi(pt) : from;
+                if (i >= from && i <= to) {
+                    const char* pb = getenv("GT_POKE_BYTES"); // hex string, e.g. "E3FE0AFE"
+                    if (pb) {
+                        size_t n = strlen(pb) / 2;
+                        for (size_t k = 0; k < n; k++) {
+                            char byteStr[3] = { pb[k*2], pb[k*2+1], 0 };
+                            u8 v = (u8) strtoul(byteStr, nullptr, 16);
+                            nds->ARM9.DataWrite8(addr + (u32)k, v);
+                        }
+                    }
+                }
+            }
+        }
+        nds->RunFrame();
+        // a shot every two seconds of game time: dialogue comes and goes, and
+        // the one frame at the end is rarely the one with text on it
+        if (i % 120 == 119) {
+            char buf[512];
+            std::snprintf(buf, sizeof buf, "%s.%04d.ppm", outpath, i / 120);
+            SaveShot(*nds, buf);
+        }
+    }
+    GT_Lo = GT_Hi = 0;
+    std::fclose(GT_Out); GT_Out = nullptr;
+
+    // Dump both screens as a PPM: the trace proves which code runs, but only a
+    // picture proves the text came out in the right direction.
+    void* top = nullptr; void* bot = nullptr;
+    if (nds->GPU.GetFramebuffers(&top, &bot) && top && bot)
+    {
+        std::string shot = std::string(outpath) + ".ppm";
+        FILE* p = std::fopen(shot.c_str(), "wb");
+        std::fprintf(p, "P6\n256 384\n255\n");
+        for (int half = 0; half < 2; half++)
+        {
+            const u32* fb = (const u32*) (half ? bot : top);
+            for (int i = 0; i < 256*192; i++)
+            {
+                u32 c = fb[i];                       // BGRA-ish, 6-bit-ish channels
+                u8 rgb[3] = { (u8)((c >> 16) & 0xFF), (u8)((c >> 8) & 0xFF), (u8)(c & 0xFF) };
+                std::fwrite(rgb, 1, 3, p);
+            }
+        }
+        std::fclose(p);
+        std::fprintf(stderr, "screenshot: %s\n", shot.c_str());
+    }
+    std::fprintf(stderr, "ran %d frames; trace in %s\n", frames, outpath);
+    return 0;
+}
