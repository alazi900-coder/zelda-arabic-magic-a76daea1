+// Minimal Platform layer for the headless tracer.
+//
+// The Qt frontend's Platform.cpp drags in a window, audio and config system for
+// a program that only needs to run frames and read memory, so the handful of
+// hooks the core actually calls are implemented here against plain stdio and
+// std::thread instead.
+#include <cstdio>
+#include <cstdarg>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <mutex>
+#include <condition_variable>
+#include <chrono>
+#include "Platform.h"
+
+namespace melonDS::Platform
+{
+
+void SignalStop(StopReason, void*) {}
+std::string InstanceFileSuffix() { return ""; }
+
+struct FileHandle { std::FILE* f; };
+
+static const char* ModeStr(FileMode mode)
+{
+    bool w = (mode & FileMode::Write) != FileMode::None;
+    bool a = (mode & FileMode::Append) != FileMode::None;
+    bool p = (mode & FileMode::Preserve) != FileMode::None;
+    if (a) return "ab";
+    if (w) return p ? "r+b" : "wb";
+    return "rb";
+}
+
+FileHandle* OpenFile(const std::string& path, FileMode mode)
+{
+    std::FILE* f = std::fopen(path.c_str(), ModeStr(mode));
+    if (!f && (mode & FileMode::Write) != FileMode::None) f = std::fopen(path.c_str(), "w+b");
+    if (!f) return nullptr;
+    return new FileHandle{f};
+}
+FileHandle* OpenLocalFile(const std::string& path, FileMode mode) { return OpenFile(path, mode); }
+std::string GetLocalFilePath(const std::string& filename) { return filename; }
+bool FileExists(const std::string& name) { std::FILE* f = std::fopen(name.c_str(), "rb"); if (!f) return false; std::fclose(f); return true; }
+bool LocalFileExists(const std::string& name) { return FileExists(name); }
+bool CheckFileWritable(const std::string&) { return true; }
+bool CheckLocalFileWritable(const std::string&) { return true; }
+bool CloseFile(FileHandle* file) { if (!file) return false; std::fclose(file->f); delete file; return true; }
+bool IsEndOfFile(FileHandle* file) { return std::feof(file->f) != 0; }
+bool FileReadLine(char* str, int count, FileHandle* file) { return std::fgets(str, count, file->f) != nullptr; }
+u64 FilePosition(FileHandle* file) { return (u64) std::ftell(file->f); }
+bool FileSeek(FileHandle* file, s64 offset, FileSeekOrigin origin)
+{
+    int o = origin == FileSeekOrigin::Start ? SEEK_SET : origin == FileSeekOrigin::Current ? SEEK_CUR : SEEK_END;
+    return std::fseek(file->f, (long) offset, o) == 0;
+}
+void FileRewind(FileHandle* file) { std::rewind(file->f); }
+u64 FileRead(void* data, u64 size, u64 count, FileHandle* file) { return std::fread(data, size, count, file->f); }
+bool FileFlush(FileHandle* file) { return std::fflush(file->f) == 0; }
+u64 FileWrite(const void* data, u64 size, u64 count, FileHandle* file) { return std::fwrite(data, size, count, file->f); }
+u64 FileWriteFormatted(FileHandle* file, const char* fmt, ...)
+{ va_list a; va_start(a, fmt); int r = std::vfprintf(file->f, fmt, a); va_end(a); return r < 0 ? 0 : (u64) r; }
+u64 FileLength(FileHandle* file)
+{ long p = std::ftell(file->f); std::fseek(file->f, 0, SEEK_END); long n = std::ftell(file->f); std::fseek(file->f, p, SEEK_SET); return (u64) n; }
+
+void Log(LogLevel, const char*, ...) {}   // the core is chatty; the trace is the output that matters
+
+struct Thread { std::thread t; };
+Thread* Thread_Create(std::function<void()> func) { return new Thread{std::thread(std::move(func))}; }
+void Thread_Free(Thread* thread) { if (thread->t.joinable()) thread->t.detach(); delete thread; }
+void Thread_Wait(Thread* thread) { if (thread->t.joinable()) thread->t.join(); }
+
+struct Semaphore { std::mutex m; std::condition_variable cv; int c = 0; };
+Semaphore* Semaphore_Create() { return new Semaphore; }
+void Semaphore_Free(Semaphore* s) { delete s; }
+void Semaphore_Reset(Semaphore* s) { std::lock_guard<std::mutex> l(s->m); s->c = 0; }
+void Semaphore_Wait(Semaphore* s) { std::unique_lock<std::mutex> l(s->m); s->cv.wait(l, [&]{ return s->c > 0; }); s->c--; }
+bool Semaphore_TryWait(Semaphore* s, int timeout_ms)
+{
+    std::unique_lock<std::mutex> l(s->m);
+    if (!s->cv.wait_for(l, std::chrono::milliseconds(timeout_ms), [&]{ return s->c > 0; })) return false;
+    s->c--; return true;
+}
+void Semaphore_Post(Semaphore* s, int count) { { std::lock_guard<std::mutex> l(s->m); s->c += count; } s->cv.notify_all(); }
+
+struct Mutex { std::mutex m; };
+Mutex* Mutex_Create() { return new Mutex; }
+void Mutex_Free(Mutex* m) { delete m; }
+void Mutex_Lock(Mutex* m) { m->m.lock(); }
+void Mutex_Unlock(Mutex* m) { m->m.unlock(); }
+bool Mutex_TryLock(Mutex* m) { return m->m.try_lock(); }
+
+void Sleep(u64 usecs) { std::this_thread::sleep_for(std::chrono::microseconds(usecs)); }
+u64 GetMSCount() { return (u64) std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+u64 GetUSCount() { return (u64) std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+
+void WriteNDSSave(const u8*, u32, u32, u32, void*) {}
